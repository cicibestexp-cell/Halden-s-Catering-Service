### Phase 2 — Supabase Migration SQL

#### [NEW] `rental_hub_migration.sql`
```sql
CREATE TABLE IF NOT EXISTS rental_orders (
  id             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  rental_order_id TEXT NOT NULL UNIQUE,          -- e.g. RO-20260809-001
  reservation_id  TEXT NOT NULL,                  -- FK to reservations
  reservation_name TEXT,
  supplier_name   TEXT DEFAULT 'Glomar P. Legaspi',
  status          TEXT DEFAULT 'request_sent',    -- request_sent | supplier_confirmed | scheduled | delivered | completed
  items           JSONB NOT NULL DEFAULT '[]',    -- [{name, category, qty_needed, status}]
  created_at      TIMESTAMPTZ DEFAULT now(),
  updated_at      TIMESTAMPTZ DEFAULT now()
);

-- Row-level security (allow all for now, restrict later)
ALTER TABLE rental_orders ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Allow all" ON rental_orders FOR ALL USING (true) WITH CHECK (true);
```

